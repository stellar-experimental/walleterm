{
  "name": "walleterm",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.sdk.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun run test:built",
    "test:built": "bun test && bun tests/contracts.ts && bun tests/extended-contracts.ts && bun tests/cap85.ts",
    "test:live": "bun tests/live.ts",
    "format": "prettier --write \"**/*.ts\" \".agents/**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\" \".agents/**/*.ts\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@twinkleplop/bash": "0.1.5",
    "@twinkleplop/json": "0.1.5",
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": {
      "types": "./dist/types/walleterm.d.ts",
      "import": "./dist/sdk/walleterm.js"
    },
    "./connect": {
      "types": "./dist/types/connect.d.ts",
      "import": "./dist/sdk/connect.js"
    },
    "./kit": {
      "types": "./dist/types/kit.d.ts",
      "import": "./dist/sdk/kit.js"
    },
    "./scan": {
      "types": "./dist/types/scan.d.ts",
      "import": "./dist/sdk/scan.js"
    },
    "./connect.css": "./sdk/connect.css"
  }
}
