{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "moduleDetection": "force",
    "noImplicitOverride": true
  },
  "include": [
    "**/*.ts",
    ".agents/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
