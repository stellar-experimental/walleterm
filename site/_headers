# Browser cache rules for Workers static assets. Anything not listed keeps the default:
# Cache-Control: public, max-age=0, must-revalidate, so a deploy shows at once.

# Font file names carry the Google Fonts version. A new font version gets a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Art and icons have no content hash, so they stay fresh within a day.
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
