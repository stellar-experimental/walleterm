--- a/fixtures/build.sh
+++ b/fixtures/build.sh
@@ -16,6 +16,10 @@
   git init -q "$SRC"
   git -C "$SRC" remote add origin "$OZ_REPO"
 fi
+if ! git -C "$SRC" diff --quiet -- || ! git -C "$SRC" diff --cached --quiet --; then
+  echo "OpenZeppelin checkout has tracked changes. Preserve them before building fixtures." >&2
+  exit 1
+fi
 if [ "$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)" != "$OZ_COMMIT" ]; then
   git -C "$SRC" fetch -q --depth 1 origin "$OZ_COMMIT"
   git -C "$SRC" checkout -q --detach FETCH_HEAD
--- a/fixtures/build.test.ts
+++ b/fixtures/build.test.ts
@@ -0,0 +1,107 @@
+import { test } from 'bun:test';
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+for (const state of ['clean', 'unstaged', 'staged']) {
+  test(`fixture build ${state === 'clean' ? 'accepts clean source' : `rejects ${state} tracked changes`}`, () => {
+    const root = mkdtempSync(join(tmpdir(), 'walleterm-fixture-build-'));
+    try {
+      const source = join(root, '.oz-src');
+      const tools = join(root, 'tools');
+      const hooks = join(root, 'hooks');
+      const output = join(root, 'wasm');
+      for (const directory of [source, tools, hooks, output, join(root, 'contracts')]) mkdirSync(directory);
+      const compilerLog = join(root, 'compiler.log');
+      const manifestLog = join(root, 'manifest.log');
+      const artifact = join(output, 'existing.wasm');
+      const manifest = join(output, 'manifest.json');
+      const env = {
+        ...process.env,
+        GIT_CONFIG_GLOBAL: '/dev/null',
+        GIT_CONFIG_NOSYSTEM: '1',
+        PATH: `${tools}:${process.env.PATH}`,
+        WALLETERM_TEST_COMPILER_LOG: compilerLog,
+        WALLETERM_TEST_MANIFEST_LOG: manifestLog,
+        WALLETERM_TEST_ARTIFACT: artifact,
+        WALLETERM_TEST_MANIFEST: manifest,
+      };
+      const git = (...args: string[]) =>
+        execFileSync(
+          'git',
+          [
+            '-C',
+            source,
+            '-c',
+            'commit.gpgsign=false',
+            '-c',
+            `core.hooksPath=${hooks}`,
+            '-c',
+            'user.name=Fixture Test',
+            '-c',
+            'user.email=fixture@example.invalid',
+            ...args,
+          ],
+          { env, encoding: 'utf8' },
+        );
+      git('init', '-q');
+      const contract = join(source, 'contract.rs');
+      writeFileSync(contract, 'reviewed source\n');
+      git('add', 'contract.rs');
+      git('commit', '-qm', 'isolated fixture source');
+      const head = git('rev-parse', 'HEAD').trim();
+      // The copied script uses the synthetic commit instead of fetching upstream.
+      writeFileSync(
+        join(root, 'build.sh'),
+        readFileSync(new URL('./build.sh', import.meta.url), 'utf8').replace(
+          /^OZ_COMMIT="[^"]*"$/m,
+          `OZ_COMMIT="${head}"`,
+        ),
+      );
+      writeFileSync(
+        join(tools, 'stellar'),
+        '#!/bin/sh\nprintf "%s\\n" "$*" >> "$WALLETERM_TEST_COMPILER_LOG"\nprintf "rebuilt" > "$WALLETERM_TEST_ARTIFACT"\n',
+        { mode: 0o700 },
+      );
+      writeFileSync(
+        join(tools, 'bun'),
+        '#!/bin/sh\nprintf "%s\\n" "$*" >> "$WALLETERM_TEST_MANIFEST_LOG"\nprintf "new manifest" > "$WALLETERM_TEST_MANIFEST"\n',
+        { mode: 0o700 },
+      );
+      writeFileSync(artifact, 'existing artifact');
+      writeFileSync(manifest, 'existing manifest');
+      if (state !== 'clean') writeFileSync(contract, 'developer change\n');
+      if (state === 'staged') git('add', 'contract.rs');
+      const before = {
+        contract: readFileSync(contract),
+        index: readFileSync(join(source, '.git', 'index')),
+        head: git('rev-parse', 'HEAD'),
+        artifact: readFileSync(artifact),
+        manifest: readFileSync(manifest),
+      };
+
+      const result = spawnSync('sh', [join(root, 'build.sh')], { env, encoding: 'utf8', timeout: 10000 });
+      assert.equal(result.error, undefined);
+      assert.equal(result.status, state === 'clean' ? 0 : 1, result.stderr);
+      assert.deepEqual(readFileSync(contract), before.contract);
+      assert.deepEqual(readFileSync(join(source, '.git', 'index')), before.index);
+      assert.equal(git('rev-parse', 'HEAD'), before.head);
+      if (state === 'clean') {
+        assert.equal(readFileSync(compilerLog, 'utf8').trim().split('\n').length, 5);
+        assert.equal(readFileSync(manifestLog, 'utf8').trim().split('\n').length, 1);
+        assert.equal(readFileSync(artifact, 'utf8'), 'rebuilt');
+        assert.equal(readFileSync(manifest, 'utf8'), 'new manifest');
+      } else {
+        assert.match(result.stderr, /tracked changes/i);
+        assert.equal(existsSync(compilerLog), false);
+        assert.equal(existsSync(manifestLog), false);
+        assert.deepEqual(readFileSync(artifact), before.artifact);
+        assert.deepEqual(readFileSync(manifest), before.manifest);
+      }
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+}
